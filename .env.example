# ===== Django =====
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===== Database =====
# Bo'sh qoldirilsa avtomatik SQLite (db.sqlite3) ishlatiladi — local test uchun shu yetarli.
# Productionda PostgreSQL kerak bo'lsa shu formatda to'ldiring:
# DATABASE_URL=postgresql://user:password@localhost:5432/barberuz
DATABASE_URL=

# ===== Media storage =====
# false = local media, true = S3-compatible object storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ===== SMS / Eskiz =====
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=

# ===== Payments =====
PAYMENT_PROVIDER=demo
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
PAYMENT_RETURN_URL=https://your-domain.uz/payment/success/

# ===== Maps =====
# Leaflet/OpenStreetMap works without a key for development.
# For production geocoding, use a provider you have permission to use.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
